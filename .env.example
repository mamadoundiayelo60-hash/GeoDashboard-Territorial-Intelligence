APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_ALLOWED_ORIGINS=http://localhost:5173
# Configure DATABASE_URL locally or through your deployment platform's secret manager.
# Never commit database credentials to Git.
POSTGRES_DB=geodashboard
POSTGRES_USER=geodashboard
# Configure POSTGRES_PASSWORD locally; no password is provided in this public template.
VITE_API_URL=http://localhost:8000
GEO_API_BASE_URL=https://geo.api.gouv.fr
GEO_API_TIMEOUT_SECONDS=8
RUNTIME_DATA_DIR=data/runtime
DEMO_DATA_PATH=data/demo/calais-facilities-osm.geojson
MAX_UPLOAD_MB=50
